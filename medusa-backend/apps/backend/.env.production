# Production deployment configuration for https://swamiomenterprises.in
NODE_ENV=production

# Update with your production PostgreSQL connection string
DATABASE_URL=postgres://postgres:CHANGE_ME@your-db-host:5432/medusa-medusa-backend

# Update with your production Redis connection string
REDIS_URL=redis://your-redis-host:6379

# Frontend storefront
STORE_CORS=https://swamiomenterprises.in,https://www.swamiomenterprises.in

# Medusa admin dashboard (served from the backend)
ADMIN_CORS=https://api.swamiomenterprises.in,https://swamiomenterprises.in

# Auth endpoints used by storefront and admin
AUTH_CORS=https://swamiomenterprises.in,https://www.swamiomenterprises.in,https://api.swamiomenterprises.in

# Generate strong secrets before deploying (do not reuse development values)
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_JWT_SECRET
COOKIE_SECRET=CHANGE_ME_GENERATE_A_STRONG_COOKIE_SECRET

# Razorpay live credentials
RAZORPAY_ID=
RAZORPAY_SECRET=
RAZORPAY_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_AUTO_EXPIRY_PERIOD=30
RAZORPAY_MANUAL_EXPIRY_PERIOD=720
